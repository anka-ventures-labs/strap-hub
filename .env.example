# Copy to .env on the hub machine. Never commit real values.
HUB_TOKEN=change-me            # bearer token the phone app sends
HUB_DB_PATH=./data/hub.db      # SQLite store
HUB_BIND=127.0.0.1:8770        # exposed to the tailnet with `tailscale serve`
HASS_URL=http://127.0.0.1:8123
HASS_TOKEN=                    # Home Assistant long-lived access token
